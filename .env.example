# SPDX-License-Identifier: MIT

# Copy to .env and use an existing absolute directory.
# Keep quotes around paths containing spaces or #.
MEDIA_DIR="/path/to/your/media"

# The published image supports amd64 / x86-64.
# latest follows main; use a release tag or digest to pin a deployment.
MEDIATOR_IMAGE=ghcr.io/johanlindvall/mediator:latest

# Local access by default. See docs/getting-started.md before enabling LAN access.
BIND_ADDRESS=127.0.0.1
PORT=8080
